# Torii Continuum — nap-bridge gateway environment (NAP-BRIDGE-1)
#
# Committed, secret-free template. `ops/install-nap-bridge.sh --render-env`
# writes the real `/home/hermes-npc/.nap-bridge/.env` (0600) from this exact
# shape, filling NPC_CLIENT_SECRET with a freshly-minted NIP-46 client key.
#
# The ONLY secret here is NPC_CLIENT_SECRET — a burnable delegation to the
# NIP-46 bunker, NOT the greeter nsec. The greeter nsec never appears on this
# host; the bunker (nsecBunker/Amber/etc.) holds it and signs on request.
#
# See docs/nap-bridge-1.md for the custody decision and the fail-closed rules.

# 1 => run the gateway; anything else => the process is a no-op.
NPC_ENABLED=1

# The gateway's NIP-46 CLIENT secret (64 hex). Generated by
# `ops/install-nap-bridge.sh --generate`. This is the delegation, not the
# greeter nsec. If this leaks, revoke it in the bunker and mint a new one —
# the greeter identity itself is not exposed.
NPC_CLIENT_SECRET=__CLIENT_SECRET__

# The operator's bunker pubkey/npub — the remote signer that holds the greeter
# nsec and answers decrypt/encrypt/sign RPCs. Public (an npub).
NPC_BUNKER_PUBKEY=

# Comma-separated Nostr relays. These are used both for the NIP-46 channel and
# for the kind-4 DM subscription.
NPC_RELAYS=

# Comma-separated npubs/hex of the senders allowed to DM the greeter.
# FAIL-CLOSED: an empty or non-matching allowlist admits nobody. Put the
# operator's npub here (and players as they are granted access).
NPC_ALLOWLIST=

# Local-only inference (the shared Ollama backend; no router, no paid path).
NPC_OLLAMA_URL=http://127.0.0.1:11434/v1
NPC_MODEL=qwen3:4b

# The greeter persona, written by ops/install-hermes-npc.sh.
NPC_SOUL_FILE=/home/hermes-npc/.hermes/profiles/npc/SOUL.md
# Torii Continuum — nap-bridge gateway environment (NAP-BRIDGE-3)
#
# Committed, secret-free template. `ops/install-nap-bridge.sh --render-env`
# writes the real `/home/hermes-npc/.nap-bridge/.env` (0600) from this exact
# shape, filling NPC_NSEC with a freshly-minted greeter nsec.
#
# The ONLY secret here is NPC_NSEC — a throwaway per-install greeter nsec with
# no funds and no delegation. There is no NIP-46 bunker and no client key.
# If it leaks, the worst case is impersonation-as-greeter (an attacker posts as
# the NPC); rotation is `rm` the .env and reinstall, or overwrite NPC_NSEC.
#
# See docs/nap-bridge-1.md for the custody decision and the fail-closed rules.

# 1 => run the gateway; anything else => the process is a no-op.
NPC_ENABLED=1

# The greeter nsec (64 hex). Minted once by `ops/install-nap-bridge.sh` on
# first install; reused on reinstall so the identity stays stable. The owner
# can export it (as nsec1) to back it up, or replace it with a nsec of their
# choosing. Not echoed after install.
NPC_NSEC=__NSEC__

# Comma-separated Nostr relays for the kind-1059 gift-wrap (NIP-17) delivery.
NPC_RELAYS=

# Comma-separated npubs/hex of the senders allowed to DM the greeter.
# FAIL-CLOSED: an empty or non-matching allowlist admits nobody. Put the
# operator's npub here (and players as they are granted access).
NPC_ALLOWLIST=

# Local-only inference (the shared Ollama backend; no router, no paid path).
NPC_OLLAMA_URL=http://127.0.0.1:11434/v1
NPC_MODEL=llama3.2:1b

# The greeter persona, written by ops/install-hermes-npc.sh.
NPC_SOUL_FILE=/home/hermes-npc/.hermes/profiles/npc/SOUL.md

# Nakama's knowledge layers (NAP-BRIDGE-7), seeded by the installer.
# WORLD.md = this world's facts (edit it); TORII_LORE.md = shared metaverse lore.
NPC_WORLD_FILE=/home/hermes-npc/.hermes/profiles/npc/WORLD.md
NPC_LORE_FILE=/home/hermes-npc/.hermes/profiles/npc/TORII_LORE.md

# Per-sender spam rate limit (checked BEFORE inference; NAP-BRIDGE-5).
NPC_RATE_WINDOW_MS=60000
NPC_RATE_MAX_PER_WINDOW=6

# 1 => admit EVERY authenticated sender (allowlist ignored; rate limit is the
# only throttle). Off (0) => fail-closed allowlist only.
NPC_PUBLIC=0

# Read-only world noticeboard (NAP-BRIDGE-8). Set to the operator's npub (hex)
# whose kind-30078 d="noticeboard" event is this world's noticeboard. Unset =>
# disabled. Nakama reads it (cached); it never publishes.
NPC_NOTICE_AUTHOR=
# noticeboard in-memory cache TTL (ms)
NPC_NOTICE_TTL_MS=60000
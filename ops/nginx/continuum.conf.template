# /opt/torii/nginx-fragments/continuum.conf
#
# Continuum's nginx fragment. Dropped here by the Continuum installer.
# The main torii.conf `include`s /opt/torii/nginx-fragments/*.conf inside
# its https server{} block, so this file only defines `location` blocks.
#
# Layout:
#   /continuum/       → the built Vite frontend (static files)
#   /continuum/api/   → reverse-proxy to the agent daemon on 127.0.0.1:@AGENT_PORT@
#
# The trailing slashes on both /continuum/api/ AND proxy_pass are load-bearing:
# they strip the /continuum prefix so the agent still sees `/api/*` internally.
# This lets the same agent code run at / on pplx.app and at /continuum on a VPS.
#
# @CONTINUUM_DIST@ MUST be a PUBLIC webroot (e.g. /var/www/torii/continuum) that
# nginx (www-data) can traverse — NOT a path under a user home. Serving the SPA
# from a 0750 home returns HTTP 500 because nginx cannot descend into it. Only the
# built static files are published there; source + encrypted state stay private.

# Single prefix alias serves BOTH the SPA entry and the Vite hashed bundle under
# /continuum/assets/*. There is deliberately NO nested `location /continuum/assets/`
# block: a nested alias + try_files re-mapped the path and returned 404 for hashed
# .js/.css in production (the black page). try_files checks real files first, so
# assets are served directly and only genuine misses fall through to the SPA entry.
location /continuum/ {
    alias @CONTINUUM_DIST@/;
    index index.html;
    try_files $uri $uri/ /continuum/index.html;
}

# The SPA entry document gates authentication client-side, so it must never be
# cached or restored stale (a cached index could re-hydrate a signed-out session
# into a usable dashboard after Back/bfcache). Exact-match so ONLY the entry is
# no-store; the content-addressed hashed bundle under /assets/* keeps normal
# static caching (there is deliberately NO `location /continuum/assets/` block —
# a nested alias there returned 404 for hashed assets in production). Both the
# `index` directive and the SPA try_files fallback internally resolve to this
# path, so every way of serving the entry gets the header.
location = /continuum/index.html {
    alias @CONTINUUM_DIST@/index.html;
    add_header Cache-Control "no-store, must-revalidate" always;
}

# Agent API — mount-prefix stripped before proxy_pass
location /continuum/api/ {
    proxy_pass http://127.0.0.1:@AGENT_PORT@/api/;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /continuum;

    # API responses are per-session and authorization-gated — never let a browser
    # or intermediary cache/replay them (a cached protected response could survive
    # sign-out). `always` so it is set on error/401 responses too.
    add_header Cache-Control "no-store" always;

    # Chat + memory endpoints can be slow (Routstr round-trip, decrypt)
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    # 512 KB matches agent's bodyLimit; give a small headroom.
    client_max_body_size 1m;
}

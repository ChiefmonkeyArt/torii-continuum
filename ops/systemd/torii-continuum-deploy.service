# Torii Continuum — unattended deploy (OPS-DEPLOY-2, v0.2.50-alpha)
#
# One-shot service invoked by torii-continuum-deploy.timer. Runs the root-owned
# deploy wrapper, which no-ops unless the root-owned pin file
# (/etc/torii/continuum-deploy.conf) names a new, allowlisted, valid release tag
# that the live agent is not already serving. This is the SERVER-SIDE PULL: no
# inbound SSH, no open ports, no secret handling.
#
# Installed by ops/deploy-bootstrap.sh.

[Unit]
Description=Torii Continuum unattended deploy (pull)
Documentation=https://github.com/ChiefmonkeyArt/torii-continuum
After=network-online.target
Wants=network-online.target

# A persistent failure (e.g. a bad pin) trips the unit into a failed state
# instead of retrying forever on the timer's back.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=oneshot
# PRE step (VERSION-UPDATE-1): translate an admin-queued, agent-spooled update
# request into a pin change BEFORE the deploy runs. The agent (unprivileged)
# cannot write the root pin, so it writes a vetted request into its memory/ dir;
# this root applier independently re-validates it (grammar + allowlist) and, only
# if it passes, rewrites CONTINUUM_TARGET_TAG. It is fail-safe: a missing/corrupt/
# unauthorized request is discarded and the baseline pin deploy proceeds. The `-`
# prefix means even an unexpected non-zero exit never blocks the deploy.
ExecStartPre=-/usr/local/sbin/torii-continuum-update-apply

# Runs as root: it installs code under /opt/deploy and runs the Ansible role
# (which manages systemd + nginx). The wrapper itself is the ONLY privileged
# surface — see ops/sudoers/torii-continuum-deploy.example for the scoped,
# NOPASSWD-on-just-this-wrapper rule used by the optional remote-trigger path.
ExecStart=/usr/local/sbin/torii-continuum-deploy
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
SyslogIdentifier=torii-continuum-deploy
TimeoutStartSec=1800

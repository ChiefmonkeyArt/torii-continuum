# Torii Hermes Web Dashboard — systemd unit (standalone install)
#
# Installed to /etc/systemd/system/torii-hermes-dashboard.service. Runs Nous
# Research's `hermes dashboard` for the owner brain, bound to loopback only.
#
# SECURITY BOUNDARY: the loopback bind is what keeps the dashboard off the
# public internet. Hermes's own auth gate is OFF on a loopback bind, and nginx
# (snippets/hermes.conf) is the sole door, gated on the Continuum admin session.
# The process MUST never bind 0.0.0.0 — if the installed binary ignores --host,
# block port 9119 for non-loopback at the firewall (defence in depth).
#
# This unit is DELIBERATELY less hardened than torii-continuum-agent.service:
# Hermes is a third-party binary whose runtime surface (subprocesses, tool
# execution from the Chat tab, model backends) is not fully known here, so
# kernel/syscall filters that are safe for our own agent could silently break
# tool execution. The loopback bind + nginx gate is the real control; the
# hardening below is best-effort and MUST be re-verified on the live box.

[Unit]
Description=Hermes Web Dashboard (owner brain, loopback-only)
Documentation=https://github.com/ChiefmonkeyArt/torii-continuum
After=network-online.target torii-continuum-agent.service
Wants=network-online.target

StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=hermes-owner
Group=hermes-owner
WorkingDirectory=/home/hermes-owner/.hermes
Environment=HOME=/home/hermes-owner

# The absolute `hermes` path is filled at install time from the owner's own
# `command -v hermes` (Nous installs into a per-user location, commonly
# ~/.local/bin/hermes). If you install this unit by hand, replace __HERMES_BIN__
# with that absolute path: under systemd the per-user PATH is not set the same
# way, so a bare `hermes` will not resolve.
#
# VERIFY the exact launch form against the installed build before first enable
# (see ops/hermes-dashboard.md focus: launch form):
#   - `hermes dashboard` (machine dashboard) shows all profiles on this box —
#     on a single-user VPS that is just the `owner` profile. Simplest default.
#   - `hermes dashboard --isolated` serves one profile in isolation if the
#     operator wants strict single-brain scope.
# Both expose the same Web Dashboard; the difference is profile scope, not the
# UI. The Chat tab's WebSocket (/api/pty) must authenticate cleanly with the
# dashboard's own gate OFF — verify before relying on it.
ExecStart=__HERMES_BIN__ dashboard --host 127.0.0.1 --port 9119 --no-open

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=torii-hermes-dashboard

# ── Sandboxing (best-effort; re-verify tool execution) ─────────────────────
NoNewPrivileges=true
ProtectSystem=strict
# Hermes owns only ~/.hermes (profiles, sessions, config). Everything else on
# the box is read-only to the service. If the Chat tab's agent executes shell
# tools that need broader writable paths, reconcile here rather than dropping
# the loopback bind.
ReadWritePaths=/home/hermes-owner/.hermes
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
# Torii Hermes Web Dashboard — systemd unit (standalone install)
#
# Installed to /etc/systemd/system/torii-hermes-dashboard.service. Runs Nous
# Research's `hermes dashboard` for the owner brain, bound to loopback only.
#
# SECURITY BOUNDARY: the loopback bind (127.0.0.1:9119) is what keeps the
# dashboard off the public internet. Hermes's OWN password auth IS engaged —
# because dashboard.public_url is set to a non-loopback hostname, Hermes's
# June-2026 hardening requires an auth provider, so `dashboard.basic_auth`
# (username + password) is the door. nginx (ops/nginx/hermes.conf) is a plain
# reverse proxy on the dashboard subdomain; it forwards, it does not auth. The
# process MUST never bind 0.0.0.0 — if the installed binary ignores --host,
# block port 9119 for non-loopback at the firewall (defence in depth).
#
# The auth signing secret (HERMES_DASHBOARD_BASIC_AUTH_SECRET) lives in Hermes's
# own env file (~/.hermes/.env, i.e. `hermes config env-path`), so login
# sessions survive restarts. It is written idempotently by the install
# workflow; if it is absent Hermes falls back to a random per-process key and
# sessions simply don't survive a restart (login again) — never a startup
# failure.
#
# This unit is DELIBERATELY less hardened than torii-continuum-agent.service:
# Hermes is a third-party binary whose runtime surface (subprocesses, tool
# execution from the Chat tab, model backends) is not fully known here, so
# kernel/syscall filters that are safe for our own agent could silently break
# tool execution. The loopback bind + Hermes auth is the real control; the
# hardening below is best-effort and MUST be re-verified on the live box.

[Unit]
Description=Hermes Web Dashboard (owner brain, loopback-only)
Documentation=https://github.com/ChiefmonkeyArt/torii-continuum
After=network-online.target torii-continuum-agent.service
Wants=network-online.target

StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=hermes-owner
Group=hermes-owner
WorkingDirectory=/home/hermes-owner/.hermes
Environment=HOME=/home/hermes-owner

# The absolute `hermes` path is filled at install time from the owner's own
# `command -v hermes` (Nous installs into a per-user location, commonly
# ~/.local/bin/hermes). If you install this unit by hand, replace __HERMES_BIN__
# with that absolute path: under systemd the per-user PATH is not set the same
# way, so a bare `hermes` will not resolve.
#
# Launch form: `hermes dashboard` (machine dashboard) attaches to ONE
# machine-level server and shows all profiles on this box — on a single-user
# VPS that is just the `owner` profile. Simple default. `hermes dashboard
# --isolated` serves one profile in isolation for strict single-brain scope.
# Both expose the same Web Dashboard; the difference is profile scope.
ExecStart=__HERMES_BIN__ dashboard --host 127.0.0.1 --port 9119 --no-open

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=torii-hermes-dashboard

# ── Sandboxing (best-effort; re-verify tool execution) ─────────────────────
NoNewPrivileges=true
ProtectSystem=strict
# Hermes owns only ~/.hermes (profiles, sessions, config). Everything else on
# the box is read-only to the service. If the Chat tab's agent executes shell
# tools that need broader writable paths, reconcile here rather than dropping
# the loopback bind.
ReadWritePaths=/home/hermes-owner/.hermes
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
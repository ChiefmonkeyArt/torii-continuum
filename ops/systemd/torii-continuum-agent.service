# Torii Continuum Agent — systemd unit (standalone install)
#
# Installed to /etc/systemd/system/torii-continuum-agent.service by
# ops/install-agent.sh. Runs the agent as the locked, non-login `continuum`
# system user from /opt/torii/continuum-agent.
#
# Security model (see ops/README.md § Security model):
#   - Dedicated unprivileged user/group, no shell, no capabilities.
#   - ProtectSystem=strict makes the whole filesystem read-only except the
#     paths in ReadWritePaths.
#   - Only the agent's runtime state (memory/) is writable, plus config.yaml
#     as a single writable FILE so the one-time first-touch admin claim can
#     persist the operator's npub. Everything else — code, node_modules,
#     the rest of the system — is read-only to the service.
#   - The agent binds 127.0.0.1:8787 only; nginx terminates TLS in front.

[Unit]
Description=Torii Continuum Agent (Node.js)
Documentation=https://github.com/ChiefmonkeyArt/torii-continuum
After=network-online.target
Wants=network-online.target

# Crash-loop protection MUST live in [Unit] — systemd only reads StartLimit*
# here, silently ignoring it in [Service]. Cap the burst so a persistent
# failure (e.g. a bad config) trips the unit into a failed state instead of
# restarting forever and spinning the CPU.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=continuum
Group=continuum
WorkingDirectory=/opt/torii/continuum-agent
Environment=NODE_ENV=production
# The absolute node path is filled in by ops/install-agent.sh from the
# operator's own `command -v node` (node is commonly /usr/local/bin/node for
# tarball/nvm installs, /usr/bin/node only for a NodeSource .deb). If you
# install this unit by hand, replace __NODE_BIN__ with your absolute node path:
# under this hardening systemd will not resolve a bare `node` from PATH.
ExecStart=__NODE_BIN__ index.mjs

# Restart safely without hammering. The StartLimit cap in [Unit] turns a
# persistent failure into a failed unit rather than an infinite restart loop.
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=torii-continuum-agent

# ── Sandboxing ────────────────────────────────────────────────────────────
# Privilege + filesystem
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# Writable state only. memory/ is the single MEMORY-1 root: Cashu wallet,
# cost/audit ledger, secrets, and all owner/bot/project-scoped ciphertexts,
# proposals, and import quarantine. pending/ holds unsigned draft events the
# operator signs in-browser. config.yaml is writable for the first-touch claim.
# Everything else (code, node_modules, the former vestigial ciphertexts/) stays
# read-only to the service.
ReadWritePaths=/opt/torii/continuum-agent/memory
ReadWritePaths=/opt/torii/continuum-agent/pending
ReadWritePaths=/opt/torii/continuum-agent/config.yaml
ReadOnlyPaths=/opt/torii/continuum-agent
PrivateTmp=true
PrivateDevices=true

# Kernel + process surface
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# NOTE: MemoryDenyWriteExecute is deliberately NOT set. V8 (Node's engine) is a
# JIT: it maps code pages writable, then mprotect()s them executable, which MDWE
# forbids — the process aborts on startup. Enabling it would trade a marginal
# hardening for a service that will not run (it could only be kept alongside
# `node --jitless`, at a large performance cost). Availability wins here; the
# JIT surface is mitigated by NoNewPrivileges + the syscall filter below.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
RemoveIPC=true
UMask=0077

# Networking: the agent must reach nginx (loopback) and Routstr/mints/Ollama
# (outbound). Restrict to the address families it actually needs — no raw
# packet, no bluetooth, no netlink beyond what the runtime requires.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target

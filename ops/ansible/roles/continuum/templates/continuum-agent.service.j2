[Unit]
Description=Torii Continuum Agent (Node.js)
Documentation=https://github.com/ChiefmonkeyArt/torii-continuum
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ continuum_user }}
Group={{ continuum_user }}
WorkingDirectory=/home/{{ continuum_user }}/app/agent
ExecStart=/usr/bin/node index.mjs
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=continuum-agent

# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
# Writable state only. memory/ is the single MEMORY-1 root (owner/bot/project
# scoped ciphertexts, proposals, quarantine, procedural, audit ledger, wallet).
# pending/ holds unsigned draft events awaiting the operator's in-browser
# signature. The former top-level ciphertexts/ path is vestigial — all encrypted
# memory now lives under memory/ — so it is intentionally NOT writable.
ReadWritePaths=/home/{{ continuum_user }}/app/agent/memory /home/{{ continuum_user }}/app/agent/pending
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
# MemoryDenyWriteExecute MUST stay off for Node.js. Node 22's V8 engine JITs with
# W^X memory (it maps executable pages and toggles their protection at runtime);
# MemoryDenyWriteExecute=yes makes the kernel refuse that mprotect, so V8 aborts
# on startup with a fatal `SetPermissions` / errno 12 (ENOMEM) and the process
# dies on SIGTRAP before it can serve. Every other sandboxing directive above and
# below is V8-compatible and stays enabled; only this one is relaxed, and only as
# far as Node requires.
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target

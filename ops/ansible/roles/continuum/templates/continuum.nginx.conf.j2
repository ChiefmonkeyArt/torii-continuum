# /opt/torii/nginx-fragments/continuum.conf
# Rendered by Ansible. Do NOT edit by hand — re-run the playbook instead.
#
# Included from /etc/nginx/sites-available/torii inside the https server{} block.
# See ops/nginx/continuum.conf.template for the annotated source.

# The SPA is served from a PUBLIC webroot ({{ continuum_webroot }}), NOT from the
# private app dir. nginx runs as www-data and cannot traverse /home/{{ continuum_user }}
# (0750 home + the agent unit's ProtectHome), so aliasing the bundle out of the
# home returns HTTP 500. The playbook rsyncs only the built static files here
# (root:root, dirs 0755 / files 0644); the app/agent source and encrypted state
# stay private under /home/{{ continuum_user }}/app.
# Single prefix alias serves BOTH the SPA entry and the Vite hashed bundle under
# {{ continuum_mount_path }}/assets/*. There is deliberately NO nested
# `location {{ continuum_mount_path }}/assets/` block: a nested alias + try_files
# re-mapped the path and returned 404 for hashed .js/.css in production (the black
# page). try_files checks real files first, so assets are served directly and only
# genuine misses fall through to the SPA entry.
location {{ continuum_mount_path }}/ {
    alias {{ continuum_webroot }}/;
    index index.html;
    try_files $uri $uri/ {{ continuum_mount_path }}/index.html;
}

# The SPA entry document gates authentication client-side, so it must never be
# cached or restored stale (a cached index could re-hydrate a signed-out session
# into a usable dashboard after Back/bfcache). Exact-match so ONLY the entry is
# no-store; the content-addressed hashed bundle under /assets/* keeps normal
# static caching (there is deliberately NO `location .../assets/` block — a
# nested alias there returned 404 for hashed assets in production). Both the
# `index` directive and the SPA try_files fallback internally resolve to this
# path, so every way of serving the entry gets the header.
location = {{ continuum_mount_path }}/index.html {
    alias {{ continuum_webroot }}/index.html;
    add_header Cache-Control "no-store, must-revalidate" always;
}

# Agent API — mount-prefix stripped before proxy_pass.
# Trailing slashes on both {{ continuum_mount_path }}/api/ AND proxy_pass are load-bearing:
# they strip the prefix so the agent still sees `/api/*` internally.
location {{ continuum_mount_path }}/api/ {
    proxy_pass http://{{ continuum_agent_host }}:{{ continuum_agent_port }}/api/;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix {{ continuum_mount_path }};

    # API responses are per-session and authorization-gated — never let a browser
    # or intermediary cache/replay them (a cached protected response could survive
    # sign-out). `always` so it is set on error/401 responses too.
    add_header Cache-Control "no-store" always;

    # Chat + memory endpoints can be slow (Routstr round-trip, decrypt)
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    # 512 KB matches agent's bodyLimit; give a small headroom.
    client_max_body_size 1m;
}
